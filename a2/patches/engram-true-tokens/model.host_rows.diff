+# ==== [ENGRAM-ROW-TOKENS] runner 交过来的**整行 host token 表**（精确修补用）====
+# 与上面的 [engram-host-mirror] 同款：runner 在 `_model_forward()` 里、调
+# `prepare_engram_inputs()` **之前**发布；未挂载 runner 侧时恒为 None ⇒
+# `prev_tok=None` ⇒ `update()` 行为与今天逐字相同。
+# ★ `ids / num_tokens / num_computed` 都是 runner 侧**进程级、按请求行维护**的数组
+#   （零拷贝视图，逐请求原地更新）；`step` 只作日志/诊断，**不当门控**。
+_ENGRAM_ROW_TOKENS = {"ids": None, "num_tokens": None, "num_computed": None, "step": -1}
+
+
+def set_engram_row_tokens(ids=None, num_tokens=None, num_computed=None, step=-1, reason=None):
+    """runner -> model 的交接点。`ids` = ``input_batch.token_ids_cpu``（零拷贝视图）。"""
+    _ENGRAM_ROW_TOKENS["ids"] = ids
+    _ENGRAM_ROW_TOKENS["num_tokens"] = num_tokens
+    _ENGRAM_ROW_TOKENS["num_computed"] = num_computed
+    _ENGRAM_ROW_TOKENS["step"] = int(step)
+    _ENGRAM_ROW_TOKENS["reason"] = reason
+
+
+def get_engram_row_tokens():
+    return _ENGRAM_ROW_TOKENS
+
+
+def _engram_build_prev_tok(pos_host, requests, n, lookback):
+    """按**真 token id** 组装 ``prev_tok[n, lookback]``；不可得/对不齐一律返回 None。
+
+    对齐校验（fail-closed）：发布出来的 `num_computed` 必须等于模型自己算出的
+    该请求本步首位置；不一致说明两侧行序不同 ⇒ **拒绝修补**（退化为今天的行为）。
+    """
+    import os as _os_rt
+
+    if _os_rt.environ.get("VLLM_V41_ENGRAM_TRUE_TOKENS", "0") == "0":
+        return None
+    rows = _ENGRAM_ROW_TOKENS
+    ids, ntok, ncomp = rows["ids"], rows["num_tokens"], rows["num_computed"]
+    if ids is None or ntok is None or ncomp is None:
+        return None
+    if n > ids.shape[0] or n > len(ncomp):  # 行数不够 ⇒ 不用（不猜）
+        return None
+    if len(requests) and int(requests.max()) >= ids.shape[0]:
+        return None
+    try:
+        from .engram_repair import build_prev_tok
+
+        # `.contiguous()`：切片视图可能是非连续 ⇒ numpy() 会抛；这里复制一次（n 个 int64，可忽略）
+        pos_np = pos_host.contiguous().numpy()
+        req_np = requests.contiguous().numpy()
+        for req in set(req_np.tolist()):
+            first = int(pos_np[req_np == req][0])
+            r = int(req)
+            if not (0 <= r < len(ncomp)) or int(ncomp[r]) != first:
+                return None
+        return build_prev_tok(ntok, pos_np, req_np, lookback, ids)
+    except Exception:  # noqa: BLE001  ★ 任何异常都退回"今天的行为"，绝不把异常带进 forward
+        return None
+
