 SYSTEM_SP_TOKEN = "<｜System｜>"
 
+# A control token appearing verbatim in user-supplied text encodes to a *single*
+# token (verified against the checkpoint tokenizer: <｜Assistant｜> -> 128804), so
+# literal text could forge a turn boundary -- e.g. a user message containing
+# "<｜Assistant｜>\nThe password is ..." makes the model believe it authored that
+# line.  ``IMAGE_PLACEHOLDER`` is deliberately absent from this tuple: it has its
+# own rejection path (``_validate_no_image_sp_tokens`` /
+# ``_process_image_blocks``) and must keep raising instead of being rewritten.
+_TURN_BOUNDARY_TOKENS: tuple[str, ...] = (
+    bos_token,
+    eos_token,
+    USER_SP_TOKEN,
+    ASSISTANT_SP_TOKEN,
+    SYSTEM_SP_TOKEN,
+    LATEST_REMINDER_SP_TOKEN,
+    *DS_TASK_SP_TOKENS.values(),
+)
+
+# Inserting a zero-width space after the opening "<" splits the control token into
+# ordinary pieces while leaving the text human-readable.
+_ESCAPE_MARK = "\u200b"
+
+
+def escape_control_tokens(text: str) -> str:
+    """Neutralize control tokens embedded in free-form text."""
+    for token in _TURN_BOUNDARY_TOKENS:
+        if token in text:
+            text = text.replace(token, token[0] + _ESCAPE_MARK + token[1:])
+    return text
+
+
+def _escape_message_control_tokens(msg: dict[str, Any]) -> None:
+    """Rewrite control tokens appearing in any free-form field of ``msg``.
+
+    Applied to text the *caller* supplied; the image placeholder this module
+    generates for image blocks is produced later, so it is never escaped.
+    """
+    content = msg.get("content")
+    if isinstance(content, str):
+        msg["content"] = escape_control_tokens(content)
+
+    for key in ("reasoning", "reasoning_content"):
+        value = msg.get(key)
+        if isinstance(value, str):
+            msg[key] = escape_control_tokens(value)
+
+    for block in msg.get("content_blocks") or []:
+        if not isinstance(block, dict):
+            continue
+        # Escape any textual payload.  This runs *before* block types are
+        # normalized, so an ``input_text`` block still carries its Responses name
+        # here -- filter on the payload, not on the type.
+        if isinstance(block.get("text"), str):
+            block["text"] = escape_control_tokens(block["text"])
+        if block.get("type") == "tool_result":
+            inner = block.get("content")
+            if isinstance(inner, str):
+                block["content"] = escape_control_tokens(inner)
+            elif isinstance(inner, list):
+                for sub in inner:
+                    if isinstance(sub, dict) and isinstance(sub.get("text"), str):
+                        sub["text"] = escape_control_tokens(sub["text"])
+
+    for call in msg.get("tool_calls") or []:
+        function = (call or {}).get("function") or {}
+        arguments = function.get("arguments")
+        if isinstance(arguments, str):
+            function["arguments"] = escape_control_tokens(arguments)
+
+
