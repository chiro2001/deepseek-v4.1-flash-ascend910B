+        nflat = n * lookback
+        for i in range(nflat):
+            row = i // lookback
+            sh = i - row * lookback
+            p = positions[row] - sh
+            prev[i] = p
+            if p >= 0:
+                ir[i] = 1
+                blk = p // block_size
+            else:
+                ir[i] = 0
+                blk = 0
+            flat[i] = block_table[request_ids[row], blk]
+        # 越界槽位重定向到本行 shift0 的页
+        for i in range(nflat):
+            if ir[i] == 0:
