+    # ---------- 3) 滚动 XOR + 取模哈希 ----------
+    if err_page < 0:
+        for r in range(n):
+            for lay in range(n_layers):
+                roll = hist[r, 0] * multipliers[lay, 0]
+                for sh in range(1, lookback):
+                    roll = roll ^ (hist[r, sh] * multipliers[lay, sh])
+                    base = (sh - 1) * n_heads
+                    for h in range(n_heads):
