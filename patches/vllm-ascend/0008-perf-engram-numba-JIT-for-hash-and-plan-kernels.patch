+                    vals[i] = -1
+                else:
+                    vals[i] = v
+            for r in range(n):
+                mn = np.int64(0)
+                for sh in range(lookback):
+                    v = vals[r * lookback + sh]
+                    if sh == 0 or v < mn:
+                        mn = v
+                    if mn < 0:
+                        hist[r, sh] = pad_id
+                    else:
+                        hist[r, sh] = v
