+            for j in range(m):
+                v = pages[pid[j], offb[j]]
+                if v >= 0:
+                    hist[rows[j], sh] = v
+                    prs[j] = 1
+                else:
+                    prs[j] = 0
+            for j in range(m):
+                act[rows[j]] = prs[j]
