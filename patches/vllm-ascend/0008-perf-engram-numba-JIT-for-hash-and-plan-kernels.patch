+            # 缺页回退：标量走法（遇缺页即上报，Python 侧抛 KeyError）
+            fell_back = np.int64(1)
+            for r in range(n):
+                for sh in range(lookback):
+                    p = positions[r] - sh
+                    if p < 0:
+                        break
+                    page = flat[r * lookback + sh]
+                    if page_present[page] == 0:
+                        err_page = page
+                        break
+                    tok = pages[page, p % block_size]
+                    if tok < 0:
