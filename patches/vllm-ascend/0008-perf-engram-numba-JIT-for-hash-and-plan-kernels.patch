+                    if page > oob_page:
+                        oob_page = page
+                    continue
+                pid[j] = page
+                offb[j] = p % block_size
+                if page_present[page] == 0:
+                    err_page = page
+                    break
+            if oob_page >= 0:
+                return err_page, oob_page, fell_back
+            if err_page >= 0:
