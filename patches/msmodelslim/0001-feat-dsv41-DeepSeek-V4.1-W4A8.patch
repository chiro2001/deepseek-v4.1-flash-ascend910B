+# -*- coding: UTF-8 -*-
+"""V4.1 的 QuaRot / norm-fuse / subgraph 映射（口径对齐 Eco-Tech Aurora W8A8 配方）。
+
+与 V4 适配器的差异：
+  * 无终端 hc_head → pre_run 只旋 embed/head
+  * compressor.* 仅存在于 kv_source 层；wgate 仅 ratio==2
+  * indexer.wq_b / indexer.weights_proj 仅存在于 index_source 层（不再与 ratio==4 绑定）
+  * 旧的 indexer.compressor.* 在 V4.1 不存在
+  * MTP：只旋 mtp.0.main_proj（其余 MTP 权重保持未旋转）
+"""
+from typing import Dict, List, Tuple
+
+from msmodelslim.core.graph import AdapterConfig, MappingConfig
+from msmodelslim.processor.quarot import QuaRotInterface
+
+
+class V41QuaRotMixin:
+    """混入 DeepSeekV41ModelAdapter：提供 P2 所需的三个接口。"""
+
+    # ------------------------------------------------------------------ helpers
+    def _v41_ratio(self, idx: int) -> int:
+        ratios = getattr(self.config, "compress_ratios", None) or []
+        return int(ratios[idx]) if idx < len(ratios) else 1
+
+    def _v41_iter_layers(self) -> List[Tuple[str, int, int, bool]]:
+        out = []
+        for i in range(int(self.config.num_hidden_layers)):
+            out.append(("layers", i, self._v41_ratio(i), False))
+        for m in range(int(getattr(self.config, "n_mtp_layers", 0) or 0)):
+            out.append(("mtp", m, 1, True))
+        return out
+
+    def _v41_is_kv_source(self, prefix: str, idx: int) -> bool:
+        return prefix == "layers" and idx in set(getattr(self.config, "kv_source_layers", ()) or ())
+
+    def _v41_is_index_source(self, prefix: str, idx: int) -> bool:
+        return prefix == "layers" and idx in set(getattr(self.config, "index_source_layers", ()) or ())
+
+    def _v41_experts(self) -> Tuple[int, int]:
+        try:
+            start, end, _ = self._get_local_expert_range()
+            return start, end
+        except Exception:
+            n = int(getattr(self.config, "n_routed_experts", 0) or 0)
+            return 0, n
+
+    # --------------------------------------------------------------- ln fuse
+    def get_ln_fuse_map(self):
+        """返回 (pre_run_map, per_layer_map)，与 QuaRot pre_run 的二元解包一致。"""
+        start, end = self._v41_experts()
+        pre_map: Dict[str, List[str]] = {"norm": ["head"]}
+        m: Dict[str, List[str]] = {}
+        for prefix, i, ratio, is_mtp in self._v41_iter_layers():
+            p = f"{prefix}.{i}"
+            m[f"{p}.ffn_norm"] = [f"{p}.ffn.gate"] + [
+                f"{p}.ffn.experts.{e}.{proj}" for proj in ("w1", "w3") for e in range(start, end)
+            ] + [f"{p}.ffn.shared_experts.{proj}" for proj in ("w1", "w3")]
+            attn_targets = [f"{p}.attn.wq_a", f"{p}.attn.wkv"]
+            if self._v41_is_kv_source(prefix, i):
+                attn_targets.append(f"{p}.attn.compressor.wkv")
+                if ratio == 2:
+                    attn_targets.append(f"{p}.attn.compressor.wgate")
+            if self._v41_is_index_source(prefix, i):
+                attn_targets.append(f"{p}.attn.indexer.weights_proj")
+            m[f"{p}.attn_norm"] = attn_targets
+            q_targets = [f"{p}.attn.wq_b"]
+            if self._v41_is_index_source(prefix, i):
+                q_targets.append(f"{p}.attn.indexer.wq_b")
+            m[f"{p}.attn.q_norm"] = q_targets
+        return pre_map, m
+
+    # --------------------------------------------------------------- rotate
+    def get_rotate_map(self, block_size):
+        start, end = self._v41_experts()
+        rot = QuaRotInterface.get_rotate_command(
+            size=self.config.dim, mode=QuaRotInterface.QuaRotMode.HADAMARD, block_size=block_size
+        )
+        rot_b_proj = QuaRotInterface.get_rotate_command(
+            size=self.config.q_lora_rank,
+            mode=QuaRotInterface.QuaRotMode.BLOCK_HADAMARD_SHIFTED,
+            block_size=block_size,
+        )
+        # pre_run：V4.1 无 hc_head_fn
+        pre_run = QuaRotInterface.RotatePair(left_rot={}, right_rot={"embed": rot, "head": rot})
+
+        left_rot: Dict[str, object] = {}
+        right_rot: Dict[str, object] = {}
+        left_b: Dict[str, object] = {}
+        right_b: Dict[str, object] = {}
+        for prefix, i, ratio, is_mtp in self._v41_iter_layers():
+            p = f"{prefix}.{i}"
+            if is_mtp:
+                if i == 0:
+                    right_rot[f"{p}.main_proj"] = rot
+                continue
+            # MoE
+            for e in range(start, end):
+                right_rot[f"{p}.ffn.experts.{e}.w1"] = rot
+                right_rot[f"{p}.ffn.experts.{e}.w3"] = rot
+                left_rot[f"{p}.ffn.experts.{e}.w2"] = rot
+            right_rot[f"{p}.ffn.shared_experts.w1"] = rot
+            right_rot[f"{p}.ffn.shared_experts.w3"] = rot
+            left_rot[f"{p}.ffn.shared_experts.w2"] = rot
+            right_rot[f"{p}.ffn.gate"] = rot
+            right_rot[f"{p}.hc_ffn_fn"] = rot
+            # Attention
+            left_rot[f"{p}.attn.wo_b"] = rot
+            right_rot[f"{p}.hc_attn_fn"] = rot
+            right_rot[f"{p}.attn.wq_a"] = rot
+            right_rot[f"{p}.attn.wkv"] = rot
+            if self._v41_is_kv_source(prefix, i):
+                right_rot[f"{p}.attn.compressor.wkv"] = rot
+                if ratio == 2:
+                    right_rot[f"{p}.attn.compressor.wgate"] = rot
+            if self._v41_is_index_source(prefix, i):
+                right_rot[f"{p}.attn.indexer.weights_proj"] = rot
+            # query 旋转对
+            left_b[f"{p}.attn.wq_a"] = rot_b_proj
+            right_b[f"{p}.attn.wq_b"] = rot_b_proj
+            if self._v41_is_index_source(prefix, i):
+                right_b[f"{p}.attn.indexer.wq_b"] = rot_b_proj
+        return (
+            [pre_run],
+            [
+                QuaRotInterface.RotatePair(left_rot=left_rot, right_rot=right_rot),
+                QuaRotInterface.RotatePair(left_rot=left_b, right_rot=right_b),
+            ],
+        )
+
+    # ------------------------------------------------------------- subgraph
+    def get_adapter_config_for_subgraph(self) -> List[AdapterConfig]:
+        start, end = self._v41_experts()
+        cfgs: List[AdapterConfig] = []
+        for prefix, i, ratio, is_mtp in self._v41_iter_layers():
+            p = f"{prefix}.{i}"
+            # up-down：共享专家 + 路由专家
+            cfgs.append(AdapterConfig(
+                subgraph_type="up-down",
+                mapping=MappingConfig(
+                    source=f"{p}.ffn.shared_experts.w3", targets=[f"{p}.ffn.shared_experts.w2"]
+                ),
+            ))
+            for e in range(start, end):
+                cfgs.append(AdapterConfig(
+                    subgraph_type="up-down",
+                    mapping=MappingConfig(
+                        source=f"{p}.ffn.experts.{e}.w3", targets=[f"{p}.ffn.experts.{e}.w2"]
+                    ),
+                ))
+            # linear-linear：wo_a → wo_b
+            cfgs.append(AdapterConfig(
+                subgraph_type="linear-linear",
+                mapping=MappingConfig(source=f"{p}.attn.wo_a", targets=[f"{p}.attn.wo_b"]),
+            ))
+            # norm-linear：attn_norm / q_norm（按 source 角色）
+            attn_targets = [f"{p}.attn.wq_a", f"{p}.attn.wkv"]
+            if self._v41_is_kv_source(prefix, i):
+                attn_targets.append(f"{p}.attn.compressor.wkv")
+                if ratio == 2:
+                    attn_targets.append(f"{p}.attn.compressor.wgate")
+            if self._v41_is_index_source(prefix, i):
+                attn_targets.append(f"{p}.attn.indexer.weights_proj")
+            cfgs.append(AdapterConfig(
+                subgraph_type="norm-linear",
+                mapping=MappingConfig(source=f"{p}.attn_norm", targets=attn_targets),
+            ))
+            q_targets = [f"{p}.attn.wq_b"]
+            if self._v41_is_index_source(prefix, i):
+                q_targets.append(f"{p}.attn.indexer.wq_b")
+            cfgs.append(AdapterConfig(
+                subgraph_type="norm-linear",
+                mapping=MappingConfig(source=f"{p}.attn.q_norm", targets=q_targets),
+            ))
+        return cfgs
