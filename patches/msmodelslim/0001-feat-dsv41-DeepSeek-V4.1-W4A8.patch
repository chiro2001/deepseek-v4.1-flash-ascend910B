+# -*- coding: UTF-8 -*-
+"""DeepSeek-V4.1-Flash 适配器（自持，非上游）。
+
+与 V4/V4-Pro 的结构差异（详见移植分析）：
+  * config.json 是多模态嵌套结构，主干超参在 text_config
+  * model_type = "deepseek_v41" / architectures = DeepseekV41ForCausalLM
+  * compress_ratios 0/1/2（纯 CSA2），需保留原始值
+  * 无终端 hc_head（delayed mHC：Block 返回 (x, ffn_pre)，最后一层 ffn_pre 收拢）
+  * 无 per-head Q RMSNorm（q_norm_after_wq_b=False）
+  * compressor/indexer 只在 kv_source/index_source 层存在
+  * MTP/DSpark 用独立专家数（step 3 实现）
+  * fp8/fp4 反量化为 32x32 + UE8M0
+
+P1 已接通：init_model（1 层模板 + 反量化 + strict load）、逐层 load
+（source/consumer 建参差异由 V41Attention 决定）、延迟 mHC 前向 generator。
+"""
+
+import os
+from typing import Any, Dict, Generator, Optional, Tuple
+from unittest.mock import patch
+
+import torch
+import torch.distributed as dist
+from torch import nn
+
+from msmodelslim.core.base.protocol import ProcessRequest
+from msmodelslim.core.const import DeviceType
+from msmodelslim.model.common.layer_wise_forward import (
+    TransformersForwardBreak,
+    generated_decoder_layer_visit_func,
+)
+from msmodelslim.model.common.weight_helper import get_state_dict
+from msmodelslim.model.deepseek_v4.model import ModelArgs
+from msmodelslim.model.deepseek_v4_dspark.model_adapter import DeepSeekV4DSparkModelAdapter
+from msmodelslim.utils.exception import InvalidModelError
+from msmodelslim.utils.logging import get_logger, logger_setter
+from msmodelslim.utils.security import json_safe_load
+
+from .convert import auto_dequant_state_dict as auto_dequant_state_dict_v41
+from .model import V41Transformer, build_model_args_from_config, shared_attn
+from .rotation_map import V41QuaRotMixin
+
+
+@logger_setter("msmodelslim.model.deepseek_v41")
+class DeepSeekV41ModelAdapter(V41QuaRotMixin, DeepSeekV4DSparkModelAdapter):
+    """DeepSeek-V4.1-Flash：CED + CSA2(0/1/2) + delayed mHC + Engram + DSpark。"""
+
+    def get_model_pedigree(self) -> str:
+        return "deepseek_v41"
+
+    # ------------------------------------------------------------------ config
+    def _load_config(self, trust_remote_code: bool = False) -> Any:
+        config_path = os.path.join(str(self.model_path), "config.json")
+        config_data = json_safe_load(config_path)
+        args = build_model_args_from_config(config_data)
+        get_logger().info(
+            "V4.1 config: layers=%s(+%s mtp) experts=%s dim=%s ratios=%s kv_src=%s ix_src=%s engram=%s max_seq_len=%s",
+            args.num_hidden_layers, args.n_mtp_layers, args.n_routed_experts, args.dim,
+            sorted(set(args.compress_ratios)), tuple(args.kv_source_layers), tuple(args.index_source_layers),
+            getattr(args, "engram_layer_ids", None), args.max_seq_len,
+        )
+        return args
+
+    # ------------------------------------------------------------------- model
+    def init_model(self, device: DeviceType = DeviceType.NPU) -> nn.Module:
+        torch.set_default_dtype(torch.bfloat16)
+        n_mtp = getattr(self.config, "n_mtp_layers", 0)
+        get_logger().info(
+            "V4.1 model: %s layers + %s MTP = %s total",
+            self.config.num_hidden_layers, n_mtp, self.config.num_hidden_layers + n_mtp,
+        )
+        origin = self.config.num_hidden_layers
+        # 只建 1 层模板；其余层由 load_decoder_if_not_exist 逐层构造。
+        # 模板里的专家层权重随后会被反量化结果覆盖，禁止随机初始化以避免
+        # 不必要的数十 GB 级 CPU 计算。
+        self.config.num_hidden_layers = 1
+        with patch.object(nn.Linear, "reset_parameters", lambda _self: None):
+            with torch.device("cpu"):
+                model = V41Transformer(self.config)
+        self.config.num_hidden_layers = origin
+
+        state_dict = get_state_dict(self.model_path, model)
+        auto_dequant_state_dict_v41("", state_dict, str(self.model_path))
+        model.load_state_dict(state_dict)
+        model.eval()
+        get_logger().info("V4.1 init_model ok (layer 0 template loaded, strict)")
+        return model
+
+    # -------------------------------------------------------------- layer wise
+    def load_decoder_if_not_exist(self, model: nn.Module, layer_prefix: str, idx: int):
+        try:
+            decoder = model.get_submodule(layer_prefix)
+        except AttributeError:
+            # 禁止 reset_parameters：DeepSeek 的专家层初始化代价极高，权重随后从
+            # checkpoint 反量化并 strict load。
+            with patch.object(nn.Linear, "reset_parameters", lambda _self: None):
+                get_logger().info("Creating V4.1 decoder layer %s", idx)
+                module_list: nn.ModuleList = model.layers
+                template_module = module_list[0]
+                decoder = template_module.__class__(layer_id=idx, args=self.config)
+
+                state_dict = get_state_dict(self.model_path, decoder, prefix=layer_prefix)
+                auto_dequant_state_dict_v41(layer_prefix, state_dict, str(self.model_path))
+                decoder.load_state_dict(state_dict, strict=True)
+                decoder.eval()
+                module_list.append(decoder)
+                get_logger().info("Create V4.1 decoder layer %s successfully", idx)
+        return decoder
+
+    def generate_decoder_layer(self, model: nn.Module):
+        for idx in range(self.config.num_hidden_layers):
+            layer_prefix = f"layers.{idx}"
+            decoder = self.load_decoder_if_not_exist(model, layer_prefix=layer_prefix, idx=idx)
+            yield layer_prefix, decoder
+        # TODO(P3): MTP/DSpark 层（partial7 num_nextn_predict_layers=0，不在 P1 范围）
+        for mtp_idx in range(getattr(self.config, "n_mtp_layers", 0)):
+            raise NotImplementedError("V4.1 DSpark MTP layer-wise load is not implemented in P1")
+
+    # ----------------------------------------------------------------- forward
+    def generate_model_forward(self, model: nn.Module, inputs: Any) -> Generator[ProcessRequest, Any, None]:
+        """逐层前向：V4.1 的 (h, pre_mix) 作为跨层状态一起传递。
+
+        `shared_attn` 是模块级单例，进入逐层前向之前必须 reset。
+        """
+        # 不能在此 reset()：layer-major 调度会清掉其它 batch 的共享条目。
+        # 槽位由 V41Attention.forward 的 shared_attn.begin(input_ids, start_pos) 切换。
+        first_block_input: Optional[Tuple] = None
+
+        def break_hook(module: nn.Module, hook_args: Tuple[Any, ...], hook_kwargs: Dict[str, Any]):
+            nonlocal first_block_input
+            first_block_input = (hook_args, hook_kwargs)
+            raise TransformersForwardBreak()
+
+        remove_handler = model.layers[0].register_forward_pre_hook(break_hook, with_kwargs=True, prepend=True)
+
+        try:
+            if isinstance(inputs, (list, tuple)):
+                model(inputs[0])
+            elif isinstance(inputs, dict):
+                model(**inputs)
+            else:
+                model(inputs)
+        except TransformersForwardBreak:
+            pass
+        except Exception as e:
+            raise e
+        finally:
+            remove_handler.remove()
+
+        if first_block_input is None:
+            raise InvalidModelError("Can't get first block input.", action="Please check the model and input")
+
+        if dist.is_initialized():
+            dist.barrier()
+
+        args, kwargs = first_block_input
+        if len(args) < 4:
+            raise InvalidModelError(
+                "V4.1 delayed mHC expects (h, start_pos, input_ids, pre_mix) at layer 0.",
+                action="Check V41Transformer.forward_hidden_states / block args.",
+            )
+        h, start_pos, input_ids, pre_mix = args
+        for name, block in self.generate_decoder_layer(model):
+            outputs = yield ProcessRequest(name, block, (h, start_pos, input_ids, pre_mix), kwargs)
+            if isinstance(outputs, (tuple, list)):
+                h, pre_mix = outputs[0], outputs[1]
+            else:
+                h, pre_mix = outputs, pre_mix
+            args = (h, start_pos, input_ids, pre_mix)
