diff --git a/msmodelslim/model/deepseek_v41/convert.py b/msmodelslim/model/deepseek_v41/convert.py
new file mode 100644
index 0000000..675db9c
--- /dev/null
+++ b/msmodelslim/model/deepseek_v41/convert.py
@@ -0,0 +1,122 @@
+# -*- coding: UTF-8 -*-
+"""DeepSeek-V4.1 反量化：支持 32x32 / 128x128 分块、UE8M0 scale、packed FP4。
+
+与 deepseek_v4/convert_fp8_to_bf16.py 的差异：
+  * decode_fp8 按 (weight.shape, scale.shape) 推断 block，不再写死 128x128
+  * decode_fp4 按 in_dim = packed.size(1) * 2 推断 fp4 block（V4.1 为 32）
+  * scale 可能是 torch.float8_e8m0fnu（UE8M0），统一转 float32
+"""
+import os
+from functools import lru_cache
+from typing import Dict
+
+import torch
+import torch.distributed as dist
+from safetensors import safe_open
+from tqdm import tqdm
+
+from msmodelslim.utils.logging import get_logger
+from msmodelslim.utils.security import get_valid_read_path, MAX_READ_FILE_SIZE_32G, json_safe_load
+
+WEIGHT_SCALE_INV = '.scale'
+
+# 官方 convert.py 的 FP4_TABLE（含符号位）
+FP4_TABLE = torch.tensor(
+    [0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0,
+     0.0, -0.5, -1.0, -1.5, -2.0, -3.0, -4.0, -6.0],
+    dtype=torch.float32,
+)
+
+
+def scale_to_float(scale: torch.Tensor) -> torch.Tensor:
+    """UE8M0 / FP32 scale -> FP32。优先原生 cast，失败则按 e8m0 指数手算。"""
+    if scale.dtype == torch.float32:
+        return scale
+    try:
+        return scale.to(torch.float32)
+    except (RuntimeError, TypeError):
+        raw = scale.view(torch.uint8).to(torch.int32) - 127
+        return torch.ldexp(torch.ones_like(raw, dtype=torch.float32), raw)
+
+
+def decode_fp8(weight: torch.Tensor, scale: torch.Tensor) -> torch.Tensor:
+    """weight: fp8 [out, in]；scale: [out/block_out, in/block_in]（V4.1 为 32x32）。"""
+    out_block = weight.size(0) // scale.size(0)
+    in_block = weight.size(1) // scale.size(1)
+    w = weight.float().unflatten(0, (-1, out_block)).unflatten(-1, (-1, in_block))
+    w = w * scale_to_float(scale).to(w.device)[:, None, :, None]
+    return w.flatten(2, 3).flatten(0, 1).bfloat16()
+
+
+def decode_fp4(packed_fp4_data: torch.Tensor, block_scales: torch.Tensor) -> torch.Tensor:
+    """packed int8 [out, in/2] + scale [out, in/fp4_block]（V4.1 fp4_block=32）。"""
+    uint8 = packed_fp4_data.view(torch.uint8)
+    low = uint8 & 0x0F
+    high = (uint8 >> 4) & 0x0F
+    # 官方：先低 nibble 后高 nibble
+    indices = torch.stack([low, high], dim=-1).flatten(-2)
+    values = FP4_TABLE.to(packed_fp4_data.device)[indices.long()]
+    in_dim = packed_fp4_data.size(1) * 2
+    fp4_block = in_dim // block_scales.size(1)
+    scales = scale_to_float(block_scales).to(values.device).repeat_interleave(fp4_block, dim=-1)
+    return (values * scales).to(torch.bfloat16)
+
+
+@lru_cache(maxsize=1)
+def get_inv_weight_map(model_path: str):
+    model_index_path = os.path.join(model_path, "model.safetensors.index.json")
+    model_index = json_safe_load(model_index_path)
+    weight_map = model_index['weight_map']
+    return {k.replace(WEIGHT_SCALE_INV, ''): v for k, v in weight_map.items() if WEIGHT_SCALE_INV in k}
+
+
+def get_inv_tensor(tensor_name, fp8_path, weight_map):
+    file_name = weight_map[tensor_name]
+    file_path = os.path.join(fp8_path, file_name)
+    file_path = get_valid_read_path(file_path, 'safetensors', size_max=MAX_READ_FILE_SIZE_32G)
+    if dist.is_initialized() and hasattr(torch, 'npu') and torch.npu.is_available():
+        device = f"npu:{torch.npu.current_device()}"
+    else:
+        device = 'cpu'
+    with safe_open(file_path, framework='pt', device=device) as f:
+        return f.get_tensor(tensor_name + WEIGHT_SCALE_INV)
+
+
+def get_real_name(name, layer_prefix=''):
+    return f'{layer_prefix}.{name}' if layer_prefix else name
+
+
+def auto_dequant_state_dict(layer_prefix: str, state_dict: dict, model_path: str):
+    weight_map = get_inv_weight_map(model_path)
+    if not weight_map:
+        return
+    try:
+        sub_weight_map = {}
+        for sub_name in state_dict:
+            sub_key = get_real_name(sub_name, layer_prefix).removesuffix('.weight')
+            if sub_key in weight_map:
+                sub_weight_map[sub_key] = weight_map[sub_key]
+        dequant_state_dict(layer_prefix, state_dict, model_path, weight_map=sub_weight_map)
+    except KeyError:
+        get_logger().warning('Safetensors files not match index.json, skip fp8/fp4 to bf16.')
+
+
+@torch.no_grad()
+def dequant_state_dict(layer_prefix: str, module: dict, model_path: str, weight_map: Dict[str, str]):
+    with tqdm(total=len(weight_map), desc='v41 fp8/fp4 to bf16') as pbar:
+        for ori_name, weight in module.items():
+            real_name = get_real_name(ori_name, layer_prefix)
+            sub_name = real_name.removesuffix('.weight')
+            if sub_name not in weight_map:
+                continue
+            if str(weight.dtype) == 'torch.float8_e4m3fn':
+                dequant = decode_fp8
+            elif weight.dtype in (torch.int8, torch.uint8):
+                dequant = decode_fp4
+            else:
+                pbar.update(1)
+                continue
+            scale = get_inv_tensor(sub_name, model_path, weight_map)
+            module[ori_name] = dequant(weight, scale.to(weight.device)).detach()
+            weight.to('meta')
+            pbar.update(1)
