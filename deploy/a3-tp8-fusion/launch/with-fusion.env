# =============================================================================
# with-fusion.env —— 起服时 source 本文件即可开启解码融合
#
# 用法（在起服脚本里）：
#     source <本包>/launch/with-fusion.env
# 或在命令行：
#     docker exec -e ASCEND_CUSTOM_OPP_PATH=... -e V41_LNORM_FUSE=1 ...
#
# 三个开关的语义、默认值、失效模式见 SWITCHES.md。
# 本文件只 export，不做任何副作用（可安全重复 source）。
# =============================================================================

# --- 必设：让 CANN 找到自研算子（融合点 B 依赖）-----------------------------
export ASCEND_CUSTOM_OPP_PATH=/vllm-workspace/3out_opp/vendors/custom_transformer

# --- 融合点 B（本包新增）：input_layernorm + wq_a.quantize → 一次三输出算子 --
#     覆盖 43 层；实测 decode ms/step -0.90%
export V41_LNORM_FUSE=1

# --- 融合点 A（上游 main 已有，用官方 2 输出算子，不依赖上面的 OPP 路径）-----
#     覆盖 35 层；实测 -0.62%
export V41_QNORM_FUSE=1

# =============================================================================
# 冒烟自检（起服后跑）：
#   curl -s http://127.0.0.1:${PORT:-19210}/health                       # 期望 200
#   tr '\0' '\n' < /proc/$(pgrep -f 'vllm serve' | head -1)/environ \
#     | grep -E 'V41_LNORM_FUSE|V41_QNORM_FUSE|ASCEND_CUSTOM_OPP_PATH'   # 期望 3 行
#
# ⚠️ 融合失效是**静默**的（输出正常、无报错、只是没收益）。验收请看
#    bneck hp p50 数字，不要只看"没崩"。详见 SWITCHES.md §2。
# =============================================================================
