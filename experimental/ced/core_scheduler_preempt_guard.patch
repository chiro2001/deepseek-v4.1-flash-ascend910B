+    def _ced_preemptible_running(self) -> list[Request]:
+        """Return requests that are safe to preempt on a CED decode node.
+
+        CED decode requests hold KV received from prefill and replay a fixed
+        128-token prefix. Normal preemption resets ``num_computed_tokens`` but
+        leaves the replay boundary intact, turning the next replay into a large
+        recompute without the required source KV. Protect the handoff until the
+        request finishes; KV pressure then delays new admissions instead.
+        """
+        if os.environ.get("V41_CED_ROLE") != "decode":
+            return self.running
+        if os.environ.get("V41_CED_PREEMPT_GUARD", "1") != "1":
+            return self.running
+        return [
+            request
+            for request in self.running
+            if not (
+                request.kv_transfer_params
+                and request.kv_transfer_params.get("ced_replay_tokens")
+            )
+        ]
+
     def _mamba_block_aligned_split(
         self,
         request: Request,
