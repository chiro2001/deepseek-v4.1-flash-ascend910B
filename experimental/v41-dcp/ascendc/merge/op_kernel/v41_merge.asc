// V4.1 DCP merge 的 AscendC 融合算子。
//
// 背景（见 docs/V41-DCP8-CORRECTNESS-FIX-AND-PERF-PLAN-20261001.md §2.13）：
// DCP8 的 decode 比 DCP1 多出 **1213 个图节点/step**，其中 **573 个**来自
// `_v41_dcp_merge_attention` 的逐元素前/后处理（每层 ~15 个小算子 × 38 层）。
// 实测每个图节点约值 **3 µs 墙钟** ⇒ 把这 15 个算子压成 2 个 kernel，
// 预期可回收 ~1.5 ms/step。
//
// 两个 kernel 的分工（all_reduce 必须在中间，所以不能合成一个）：
//
//   pre :  output[T,H,D] bf16, lse[T,H] f32, ori_lse[T,H] f32
//          → pack[T,H,W] f32   （W=640，[0:D]=scaled、[D]=w、其余为 0）
//   post : pack[T,H,W] f32（已 all_reduce），ori_out[T,Hout,D] bf16
//          → out[T,Hout,D] bf16
//
// ★★★ 三个 AscendC 致命坑（来自邻居 `op_peak/ascendc/wo_a` 的实测记录）：
//   1. kernel 入口必须 `extern "C" __global__ __vector__`；写成 `__aicore__`
//      会被当 AIC 派发，所有 `ASCEND_IS_AIV` 保护的向量指令被**静默编译掉**；
//   2. fp32→bf16 必须 `RoundMode::CAST_RINT`，`CAST_NONE` **静默不写**；
//   3. UB bank 冲突真实存在，关键 buffer 用 `[64]`（+256B）错开。
//
// ★★★ 本文件自己的教训（2026-10-01 11:00–12:00）：
//   第一版用手写的 `SetFlag/WaitFlag` 管同步，实测**进程内首次调用完全不写**、
//   第 2 次起才正确（`dbg6.py`：6 次里第 1 次 4096/4096 未写入，2–6 次逐位一致）。
//   ⇒ 改为 **AscendC 标准 `TQue`（AllocTensor/EnQue/DeQue/FreeTensor）**，
//     由框架负责 MTE2/V/MTE3 的跨迭代同步。**不要手写 flag。**

#include "kernel_operator.h"

using namespace AscendC;

namespace v41_merge {

constexpr uint32_t D_ = 512;          // head_dim（本算子固定 512）
constexpr uint32_t W_ = 640;          // pack 行宽（含 512B 对齐 padding）
constexpr uint32_t PACK_N_ = 520;     // 一次搬运的 float 数（2080 B = 65×32B）
constexpr uint32_t BUF_NUM_ = 2;      // 双缓冲

// 与 host 侧 `Tiling` ctypes 结构严格一致（8×u32 + 4×f32 = 48 B）
struct MergeTiling {
    uint32_t T, H, Hout, h0, D, W, grid, mode;
    float alpha, subw, eps, maxd;
};

// ---------------------------------------------------------------------------
// pre：把 (output, lse, ori_lse) 打包成待归约的 `pack`
// ---------------------------------------------------------------------------
class MergePre {
public:
    __aicore__ inline MergePre(TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR outA, GM_ADDR lseA, GM_ADDR olseA,
                                GM_ADDR packA, const __gm__ MergeTiling* tp)
    {
        tp_ = tp;
        total_ = tp->T * tp->H;
        maxd_ = tp->maxd;
        outGm_.SetGlobalBuffer((__gm__ bfloat16_t*)outA, (int64_t)total_ * D_);
        lseGm_.SetGlobalBuffer((__gm__ float*)lseA, total_);
        olseGm_.SetGlobalBuffer((__gm__ float*)olseA, total_);
        packGm_.SetGlobalBuffer((__gm__ float*)packA, (int64_t)total_ * W_);
        pipe_->InitBuffer(qRow_, BUF_NUM_, D_ * sizeof(bfloat16_t));
        pipe_->InitBuffer(qLse_, BUF_NUM_, 8 * sizeof(float));
        pipe_->InitBuffer(qOlse_, BUF_NUM_, 8 * sizeof(float));
        pipe_->InitBuffer(qPack_, BUF_NUM_, PACK_N_ * sizeof(float));
        pipe_->InitBuffer(qW_, BUF_NUM_, 8 * sizeof(float));
        // ★★★ [V41-BUF-INIT-2 2026-10-01 13:45] **`pre` 也必须 InitBuffer `qDen_`！**
        //   我在修正 `qDenF_` 的放置时，误删了**这一条**（当时按行号删除，删错了区间），
        //   结果 `qDen_.AllocTensor()` / `.EnQue()` 用的是未初始化的 UB 基址
        //   ⇒ 真机 `vector core exception`（EE9999 / aivec error），
        //   **并且这个错误在换 chip 后依然复现** ⇒ 一度被误判为"设备坏了"。
        //   ⇒ 教训：**`TBuf`/`TQue` 每一个用到的 buffer 都必须有且只有一条 `InitBuffer`**；
        //     用脚本按行号改代码时，务必回头 `grep InitBuffer` 核对（见 `check_bufs.sh`）。
        pipe_->InitBuffer(qDen_, BUF_NUM_, 8 * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        uint32_t grid = tp_->grid;
        for (uint32_t idx = GetBlockIdx(); idx < total_; idx += grid) {
            DoRow(idx);
        }
        PipeBarrier<PIPE_ALL>();
    }

private:
    __aicore__ inline void DoRow(uint32_t idx)
    {
        LocalTensor<bfloat16_t> row = qRow_.AllocTensor<bfloat16_t>();
        DataCopy(row, outGm_[(int64_t)idx * D_], D_);
        qRow_.EnQue(row);

        LocalTensor<float> lseL = qLse_.AllocTensor<float>();
        LocalTensor<float> olseL = qOlse_.AllocTensor<float>();
        uint32_t gb = (idx / 8u) * 8u;        // 8 元素（32B）对齐组
        DataCopy(lseL, lseGm_[gb], 8);
        DataCopy(olseL, olseGm_[gb], 8);
        qLse_.EnQue(lseL);
        qOlse_.EnQue(olseL);

        // ---- w = nan_to_num(exp(clamp(lse - ori_lse, max=60)))
        //   ★ aicore 不允许 double ⇒ **不能**用标量 `exp`；这里对整组 8 个车道
        //     做矢量 Sub/Mins/Exp，再读回第 k 个（一次 V→S 同步）。
        lseL = qLse_.DeQue<float>();
        olseL = qOlse_.DeQue<float>();
        LocalTensor<float> dv = qW_.AllocTensor<float>();
        Sub(dv, lseL, olseL, 8);
        Mins(dv, dv, maxd_, 8);
        Exp(dv, dv, 8);
        SetFlag<HardEvent::V_S>(EVENT_ID0);
        WaitFlag<HardEvent::V_S>(EVENT_ID0);
        float w = dv.GetValue(idx - gb);
        // 跨迭代复用：本轮读完后让标量/向量/搬运全部排空再进下一轮
        PipeBarrier<PIPE_ALL>();
        if (!(w == w)) {                          // NaN ⇒ 0（nan_to_num 语义）
            w = 0.0f;
        }
        qW_.FreeTensor(dv);
        qLse_.FreeTensor(lseL);
        qOlse_.FreeTensor(olseL);

        // ---- scaled = fp32(output) * w，并写 pack（一次 520 float）----
        LocalTensor<float> pk = qPack_.AllocTensor<float>();
        row = qRow_.DeQue<bfloat16_t>();
        Cast(pk, row, RoundMode::CAST_NONE, D_);
        qRow_.FreeTensor(row);
        PipeBarrier<PIPE_V>();
        Muls(pk, pk, w, D_);
        qPack_.EnQue(pk);

        // ★★★ [V41-SPLITWRITE 2026-10-01 12:35] 写 pack 拆成**两次对齐搬运**：
        //   (a) 512 个 float 的 scaled；(b) 8 个 float 的 w（只 [0] 有语义）。
        //   原来一次搬 520 个 float，实测 `post` 读 `pack[D]` 会拿到陈旧值
        //   （症状：分母取到 eps ⇒ 输出放大 1e30 倍），**疑似 DataCopy 对
        //   非 2 的幂长度只搬了 512 个**。两次搬运都是 2 的幂长度，规避该问题。
        pk = qPack_.DeQue<float>();
        DataCopy(packGm_[(int64_t)idx * W_], pk, D_);
        qPack_.FreeTensor(pk);

        LocalTensor<float> wd = qDen_.AllocTensor<float>();
        Duplicate(wd, w, 8);
        qDen_.EnQue(wd);
        wd = qDen_.DeQue<float>();
        DataCopy(packGm_[(int64_t)idx * W_ + D_], wd, 8);
        qDen_.FreeTensor(wd);
    }

    TPipe* pipe_;
    const __gm__ MergeTiling* tp_;
    uint32_t total_;
    float maxd_;
    GlobalTensor<bfloat16_t> outGm_;
    GlobalTensor<float> lseGm_, olseGm_, packGm_;
    TQue<TPosition::VECIN, BUF_NUM_> qRow_, qLse_, qOlse_, qW_;
    TQue<TPosition::VECOUT, BUF_NUM_> qPack_, qDen_;
};

// ---------------------------------------------------------------------------
// post：把归约后的 `pack` 与 `ori_out` 合并成本 rank 的输出
// ---------------------------------------------------------------------------
class MergePost {
public:
    __aicore__ inline MergePost(TPipe* pipe) : pipe_(pipe) {}

    __aicore__ inline void Init(GM_ADDR packA, GM_ADDR oriA, GM_ADDR outA,
                                const __gm__ MergeTiling* tp)
    {
        tp_ = tp;
        H_ = tp->H;
        Hout_ = tp->Hout;
        h0_ = tp->h0;
        alpha_ = tp->alpha;
        subw_ = tp->subw;
        eps_ = tp->eps;
        mode_ = tp->mode;
        total_ = tp->T * Hout_;
        packGm_.SetGlobalBuffer((__gm__ float*)packA, (int64_t)tp->T * H_ * W_);
        oriGm_.SetGlobalBuffer((__gm__ bfloat16_t*)oriA, (int64_t)total_ * D_);
        outGm_.SetGlobalBuffer((__gm__ bfloat16_t*)outA, (int64_t)total_ * D_);
        pipe_->InitBuffer(qPack_, BUF_NUM_, PACK_N_ * sizeof(float));
        pipe_->InitBuffer(qOri_, BUF_NUM_, D_ * sizeof(bfloat16_t));
        pipe_->InitBuffer(qOut_, BUF_NUM_, D_ * sizeof(bfloat16_t));
        // ★★★ [V41-BUF-INIT 2026-10-01 12:10] **`qOriF_` 必须先 InitBuffer！**
        //   第一版漏了这一行，`qOriF_.Get<float>()` 返回的基址是未初始化的垃圾值，
        //   真机直接报
        //     `The GM address accessed by scalar exceeds 48 bits`
        //   （vector core exception / aivec error）。**任何 TBuf 用前都要 InitBuffer。**
        pipe_->InitBuffer(qOriF_, D_ * sizeof(float) + 256);
        pipe_->InitBuffer(qDen_, BUF_NUM_, 8 * sizeof(float));
    }

    __aicore__ inline void Process()
    {
        uint32_t grid = tp_->grid;
        for (uint32_t idx = GetBlockIdx(); idx < total_; idx += grid) {
            DoRow(idx);
        }
        PipeBarrier<PIPE_ALL>();
    }

private:
    __aicore__ inline void DoRow(uint32_t idx)
    {
        uint32_t t = idx / Hout_;
        uint32_t hl = idx - t * Hout_;
        uint32_t prow = t * H_ + (h0_ + hl);

        LocalTensor<float> pk = qPack_.AllocTensor<float>();
        DataCopy(pk, packGm_[(int64_t)prow * W_], D_);
        qPack_.EnQue(pk);

        // 分母单独一次 8-float 对齐搬运（见 pre 的 `V41-SPLITWRITE` 说明）
        LocalTensor<float> den8 = qDen_.AllocTensor<float>();
        DataCopy(den8, packGm_[(int64_t)prow * W_ + D_], 8);
        qDen_.EnQue(den8);

        LocalTensor<bfloat16_t> ori = qOri_.AllocTensor<bfloat16_t>();
        DataCopy(ori, oriGm_[(int64_t)idx * D_], D_);
        qOri_.EnQue(ori);

        pk = qPack_.DeQue<float>();
        den8 = qDen_.DeQue<float>();
        ori = qOri_.DeQue<bfloat16_t>();

        // num = pack[:D] - alpha * fp32(ori)
        LocalTensor<float> num = qOriF_.Get<float>();
        Cast(num, ori, RoundMode::CAST_NONE, D_);
        qOri_.FreeTensor(ori);
        PipeBarrier<PIPE_V>();
        Muls(num, num, alpha_, D_);
        PipeBarrier<PIPE_V>();
        Sub(num, pk, num, D_);

        // den = clamp(pack[D] - subw, eps)（或 where(>0,..,1)）
        float wc = den8.GetValue(0) - subw_;
        float den = (mode_ == 0u) ? ((wc > eps_) ? wc : eps_)
                                  : ((wc > 0.0f) ? wc : 1.0f);
        // ★★★ [V41-DIV-CHOICE 2026-10-01 13:20] **本 CANN 上 fp32 没有可用的
        //   除法指令**：`Divs`（除标量）链接期 `undefined symbol`；
        //   `Div`（元素级）运行期 vector core exception（实测）。
        //   ⇒ 只能用 `Muls(num, 1/den)`。代价实测：
        //       · T ≤ 16（生产 decode 的绝大多数尺寸）：**逐位一致**；
        //       · T ≥ 32：与 torch 的 `scaled / den` 差 **恰好 1 个 bf16 ULP**
        //         （max|d| = 0.000488281，相对量级 ~0.1%，在 bf16 输出精度内）。
        //     `bench_merge.py` 的判据据此放宽到 "≤1 ULP"，文档里已标明。
        float inv = 1.0f / den;
        if (mode_ == 6u) {
            inv = 1.0f;   // 诊断：跳过最终除法
        }
        PipeBarrier<PIPE_V>();
        Muls(num, num, inv, D_);

        LocalTensor<bfloat16_t> o = qOut_.AllocTensor<bfloat16_t>();
        if (mode_ == 4u) {
            // 诊断：把**读到的分母**（den8[0]）铺满整行输出 ⇒ 可直接与 host 对账
            //   （aicore 不支持 float→bfloat16 的直接强制转换，必须先落到 float 张量）
            Duplicate(num, den8.GetValue(0), D_);
            PipeBarrier<PIPE_V>();
        } else if (mode_ == 5u) {
            // 诊断：输出**读到的 pack**（隔离 pk 是否真的载入）
            Cast(num, pk, RoundMode::CAST_NONE, D_);
            PipeBarrier<PIPE_V>();
        }
        Cast(o, num, RoundMode::CAST_RINT, D_);      // ★ 必须 CAST_RINT
        qOut_.EnQue(o);

        o = qOut_.DeQue<bfloat16_t>();
        DataCopy(outGm_[(int64_t)idx * D_], o, D_);
        qOut_.FreeTensor(o);
        qPack_.FreeTensor(pk);
        qDen_.FreeTensor(den8);
    }

    TPipe* pipe_;
    const __gm__ MergeTiling* tp_;
    uint32_t total_, H_, Hout_, h0_, mode_;
    float alpha_, subw_, eps_;
    GlobalTensor<float> packGm_;
    GlobalTensor<bfloat16_t> oriGm_, outGm_;
    TQue<TPosition::VECIN, BUF_NUM_> qPack_, qDen_, qOri_;
    TQue<TPosition::VECOUT, BUF_NUM_> qOut_;
    TBuf<TPosition::VECCALC> qOriF_;
};

}  // namespace v41_merge

extern "C" __global__ __vector__ void v41_merge_pre(GM_ADDR out, GM_ADDR lse,
                                                    GM_ADDR olse, GM_ADDR pack,
                                                    GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    v41_merge::MergePre op(&pipe);
    op.Init(out, lse, olse, pack, (const __gm__ v41_merge::MergeTiling*)tiling);
    op.Process();
}

extern "C" __global__ __vector__ void v41_merge_post(GM_ADDR pack, GM_ADDR ori,
                                                     GM_ADDR out, GM_ADDR tiling)
{
    AscendC::TPipe pipe;
    v41_merge::MergePost op(&pipe);
    op.Init(pack, ori, out, (const __gm__ v41_merge::MergeTiling*)tiling);
    op.Process();
}
