+def _node_mem_free_bytes(numa_node: int) -> int | None:
+    """Bytes free on one NUMA node, or None when that node's meminfo is unreadable.
+
+    Readable from inside the container on the images we tested. The value is only a
+    hint -- the kernel will also reclaim page cache to make room -- and we compare
+    against MemFree alone, which is the conservative side of the comparison.
+    """
+    path = f"/sys/devices/system/node/node{numa_node}/meminfo"
+    try:
+        with open(path, encoding="utf-8") as fh:
+            for line in fh:
+                fields = line.split()
+                # e.g. "Node 6 MemFree:       17476068 kB"
+                if len(fields) >= 4 and fields[2].rstrip(":") == "MemFree":
+                    return int(fields[3]) * 1024
+    except (OSError, ValueError, IndexError):
+        return None
+    return None
+
